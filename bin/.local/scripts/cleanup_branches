#!/bin/bash

# ANSI color codes
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}Fetching latest remote information...${NC}"
git fetch --prune

echo -e "${BLUE}Looking for branches to clean up...${NC}"

# Get list of branches without remote tracking
no_remote_branches=$(git branch -vv | grep -v "\[origin/" | awk '{print $1}')

# Get list of branches whose remote tracking branch is gone
gone_branches=$(git branch -vv | grep ': gone]' | awk '{print $1}')

# Combine both lists and remove duplicates
all_branches=$(echo -e "$no_remote_branches\n$gone_branches" | sort | uniq)

# If no branches found, exit
if [ -z "$all_branches" ]; then
  echo -e "${RED}No branches to clean up found.${NC}"
  exit 0
fi

# Process each branch
for branch in $all_branches; do
  # Skip if branch is current branch (has an asterisk)
  if [[ $branch == "*" ]]; then
    continue
  fi

  # Get the commit ID for the branch
  commit_id=$(git rev-parse $branch)

  # Get commit date in a readable format
  commit_date=$(git show -s --format=%cd --date=format:"%Y-%m-%d %H:%M:%S" $commit_id)

  # Get commit message
  commit_message=$(git show -s --format=%s $commit_id)

  # Check if branch has no remote or if remote is gone
  if echo "$gone_branches" | grep -q "$branch"; then
    branch_status="${RED}[Remote branch deleted]${NC}"
  else
    branch_status="${YELLOW}[No remote tracking]${NC}"
  fi

  # Display branch information
  echo -e "\n${GREEN}Branch: $branch${NC} $branch_status"
  echo -e "${YELLOW}Last commit date: $commit_date${NC}"
  echo "Commit message: $commit_message"

  # Ask for confirmation to delete
  read -p "Do you want to remove this branch locally? (Y/n): " choice

  # Default to Yes if Enter is pressed
  choice=${choice:-Y}

  # Process the choice
  if [[ $choice =~ ^[Yy]$ ]]; then
    # Check if we're on the branch we're trying to delete
    current_branch=$(git symbolic-ref --short HEAD)
    if [ "$current_branch" == "$branch" ]; then
      echo -e "${RED}Cannot delete the current branch. Switching to main first...${NC}"
      git checkout main 2>/dev/null || git checkout master 2>/dev/null

      # Check if switch was successful
      if [ $? -ne 0 ]; then
        echo -e "${RED}Failed to switch to main/master. Skipping deletion.${NC}"
        continue
      fi
    fi

    # Try to delete the branch
    if git branch -D $branch; then
      echo -e "${GREEN}Branch $branch deleted successfully.${NC}"
    else
      echo -e "${RED}Failed to delete branch $branch.${NC}"
    fi
  else
    echo -e "Branch $branch kept."
  fi
done

echo -e "\n${GREEN}Branch cleanup completed.${NC}"
